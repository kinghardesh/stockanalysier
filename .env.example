# Postgres
POSTGRES_USER=algotrader
POSTGRES_PASSWORD=algotrader
POSTGRES_DB=algotrader
DATABASE_URL=postgresql+psycopg://algotrader:algotrader@postgres:5432/algotrader

# Redis
REDIS_URL=redis://redis:6379/0

# Alpaca paper (get from https://app.alpaca.markets/paper/dashboard/overview)
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER=true

# NewsAPI free tier
NEWSAPI_KEY=

# SEC EDGAR requires a real contact in User-Agent
EDGAR_USER_AGENT=trading-agent your-name@example.com

# Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Ollama: use host.docker.internal when Ollama runs natively on the host
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.3:70b
LLM_PROVIDER_CHAIN=["gemini","ollama"]
LLM_BATCH_SIZE=10
LLM_BATCH_TIMEOUT_SECONDS=30

# Dashboard (Phase 4) — required to use the HITL approval UI
DASHBOARD_AUTH_TOKEN=
TIER3_APPROVAL_TIMEOUT_MINUTES=30
POSITION_MONITOR_INTERVAL_MINUTES=30
MEAN_REVERSION_UNIVERSE=whitelist

# App
ENVIRONMENT=development
LOG_LEVEL=INFO
